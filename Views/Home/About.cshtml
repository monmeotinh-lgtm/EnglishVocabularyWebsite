@{
    ViewBag.Title = "Giới thiệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="fw-bold text-success mb-3">Về English App</h1>
            <p class="text-muted lead mb-5">Hệ thống hỗ trợ học từ vựng tiếng Anh thông minh qua Flashcard và trắc nghiệm tương tác.</p>
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-6">
            <div class="card bg-black text-light border border-secondary shadow-sm rounded-4 p-4 h-100">
                <h4 class="text-success fw-bold mb-3">🎯 Mục tiêu đồ án</h4>
                <p class="text-secondary">Xây dựng nền tảng web hiện đại giúp người học tiếp thu từ vựng tiếng Anh nhanh chóng, ghi nhớ lâu dài thông qua phương pháp học trực quan và hệ thống câu hỏi trắc nghiệm đa dạng.</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card bg-black text-light border border-secondary shadow-sm rounded-4 p-4 h-100">
                <h4 class="text-success fw-bold mb-3">🚀 Tính năng nổi bật</h4>
                <ul class="text-secondary ps-3 mb-0">
                    <li class="mb-2">Học từ vựng trực quan theo từng chủ đề (Flashcard).</li>
                    <li class="mb-2">Kiểm tra kiến thức qua hệ thống Quiz tương tác.</li>
                    <li class="mb-2">Phân quyền tài khoản rõ ràng (Thành viên / Quản trị viên).</li>
                    <li>Giao diện thân thiện, tương thích mượt mà trên mọi thiết bị.</li>
                </ul>
            </div>
        </div>
    </div>
</div>