@model English_Vocabulary_Learning_Website.Models.Vocabulary

@{
    ViewBag.Title = "Thêm từ vựng mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-light" style="max-width: 600px;">
    <h2 class="fw-bold text-success mb-4 text-center">THÊM TỪ VỰNG MỚI</h2>

    <div class="card bg-black border border-secondary p-4 rounded-4 shadow-lg">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("TopicId", (int)ViewBag.TopicId)

            <div class="mb-3">
                <label class="form-label fw-semibold">Từ vựng (English):</label>
                @Html.TextBoxFor(m => m.Word, new { @class = "form-control bg-dark text-light border-secondary", required = "required", placeholder = "Ví dụ: Algorithm" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Phiên âm (Pronunciation):</label>
                @Html.TextBoxFor(m => m.Pronunciation, new { @class = "form-control bg-dark text-light border-secondary", placeholder = "Ví dụ: /ˈælɡərɪðəm/" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ý nghĩa (Meaning):</label>
                @Html.TextBoxFor(m => m.Meaning, new { @class = "form-control bg-dark text-light border-secondary", required = "required", placeholder = "Ví dụ: Thuật toán" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ví dụ câu (Example):</label>
                @Html.TextAreaFor(m => m.Example, new { @class = "form-control bg-dark text-light border-secondary", rows = 3, placeholder = "Ví dụ: The search algorithm is very fast." })
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("VocabularyList", "Admin", new { topicId = ViewBag.TopicId })" class="btn btn-outline-secondary px-4 rounded-pill">Quay lại</a>
                <button type="submit" class="btn btn-success px-4 rounded-pill fw-bold">Lưu từ vựng</button>
            </div>
        }
    </div>
</div>