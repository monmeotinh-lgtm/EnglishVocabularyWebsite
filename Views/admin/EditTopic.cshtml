
@model English_Vocabulary_Learning_Website.Models.Topic
@{
    ViewBag.Title = "Chỉnh sửa Chủ đề";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Cập nhật thông tin Chủ đề</h2>
    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <div class="mb-3">
            <label class="form-label"><b>Tên chủ đề:</b></label>
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
        </div>

        <div class="mb-3">
            <label class="form-label"><b>Mô tả:</b></label>
            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 3 })
        </div>

        <div class="mb-3">
            <label class="form-label"><b>Đường dẫn hình ảnh (ImageUrl):</b></label>
            @Html.EditorFor(model => model.ImageUrl, new { htmlAttributes = new { @class = "form-control" } })
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">Quay lại</a>
    }
</div>

