@model English_Vocabulary_Learning_Website.Models.Quiz

@{
    ViewBag.Title = "Thêm câu hỏi trắc nghiệm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-light" style="max-width: 650px;">
    <h2 class="fw-bold text-success mb-4 text-center">THÊM CÂU HỎI TRẮC NGHIỆM MỚI</h2>

    <div class="card bg-black border border-secondary p-4 rounded-4 shadow-lg">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("TopicId", (int)ViewBag.TopicId)

            <div class="mb-3">
                <label class="form-label fw-semibold">Nội dung câu hỏi:</label>
                @Html.TextAreaFor(m => m.Question, new { @class = "form-control bg-dark text-light border-secondary", rows = 3, required = "required", placeholder = "Ví dụ: What is the meaning of 'Algorithm'?" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Đáp án A:</label>
                    @Html.TextBoxFor(m => m.OptionA, new { @class = "form-control bg-dark text-light border-secondary", required = "required" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Đáp án B:</label>
                    @Html.TextBoxFor(m => m.OptionB, new { @class = "form-control bg-dark text-light border-secondary", required = "required" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Đáp án C:</label>
                    @Html.TextBoxFor(m => m.OptionC, new { @class = "form-control bg-dark text-light border-secondary", required = "required" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Đáp án D:</label>
                    @Html.TextBoxFor(m => m.OptionD, new { @class = "form-control bg-dark text-light border-secondary", required = "required" })
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Đáp án đúng (Nhập chữ cái tương ứng: A, B, C hoặc D):</label>
                @Html.TextBoxFor(m => m.CorrectAnswer, new { @class = "form-control bg-dark text-light border-secondary", required = "required", placeholder = "Ví dụ: A" })
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("QuizList", "Admin", new { topicId = ViewBag.TopicId })" class="btn btn-outline-secondary px-4 rounded-pill">Quay lại</a>
                <button type="submit" class="btn btn-success px-4 rounded-pill fw-bold">Lưu câu hỏi</button>
            </div>
        }
    </div>
</div>