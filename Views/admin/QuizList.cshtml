@model IEnumerable<English_Vocabulary_Learning_Website.Models.Quiz>

@{
    ViewBag.Title = "Quản lý Trắc nghiệm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4 text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-light m-0">Câu hỏi trắc nghiệm thuộc chủ đề: <span class="text-success">@ViewBag.TopicName</span></h2>
        <div>
            <a href="@Url.Action("AddQuiz", "Admin", new { topicId = ViewBag.TopicId })" class="btn btn-success px-4 rounded-pill shadow-sm me-2">
                <i class="bi bi-plus-lg"></i> + Thêm câu hỏi mới
            </a>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary rounded-pill px-4">&larr; Quay lại danh sách chủ đề</a>
        </div>
    </div>

    <div class="card bg-black border border-secondary rounded-4 shadow-lg overflow-hidden p-4">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Câu hỏi</th>
                    <th>Đáp án A</th>
                    <th>Đáp án B</th>
                    <th>Đáp án C</th>
                    <th>Đáp án D</th>
                    <th class="text-center">Đáp án đúng</th>
                    <th class="text-center" style="width: 100px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var q in Model)
                    {
                        <tr>
                            <td class="fw-bold text-warning">@q.Question</td>
                            <td>@q.OptionA</td>
                            <td>@q.OptionB</td>
                            <td>@q.OptionC</td>
                            <td>@q.OptionD</td>
                            <td class="text-center"><span class="badge bg-success px-3 py-2">@q.CorrectAnswer</span></td>
                            <td class="text-center">
                                <a href="@Url.Action("DeleteQuiz", "Admin", new { id = q.Id })" class="btn btn-danger btn-sm px-2 rounded-pill fw-semibold" onclick="return confirm('Bạn có chắc muốn xóa câu hỏi này không?');">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">Chưa có câu hỏi trắc nghiệm nào trong chủ đề này.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>